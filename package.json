{
  "name": "dsh-laivox-tts",
  "version": "0.7.12",
  "private": false,
  "description": "把 TXT、EPUB、PDF 小说做成单人朗读或多角色有声书，也能一键朗读对话里的 AI 回答，支持本地书架与 MP3/WAV 导出。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaolai181/dsh_laivox_tts.git"
  },
  "homepage": "https://github.com/xiaolai181/dsh_laivox_tts#readme",
  "bugs": {
    "url": "https://github.com/xiaolai181/dsh_laivox_tts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0-0 || >=0.3.0-rc.1 <0.4.0-0"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src/host",
    "src/domain",
    "assets/voice-previews",
    "assets/samples",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "icon.svg",
    "locale",
    "docs/DETAIL.md",
    "docs/DETAIL.en.md",
    "docs/DETAIL.zh-hant.md",
    "docs/GUIDE.md",
    "assets/icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "mpg123-decoder": "1.0.3",
    "parse5": "7.3.0",
    "pdfjs-dist": "6.5.438",
    "saxes": "6.0.0",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.8.0",
    "esbuild": "0.28.1",
    "lucide-react": "1.63.0",
    "msedge-tts": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
